# OpenAI API key used when RAGAS runs with --judge openai (gpt-4o-mini).
# The default --judge ollama backend does not require this variable.
OPENAI_API_KEY=sk-...

# Ollama parallel-request slots. The evaluation CLI reads this value to
# size the judge batch (batch = 10 * OLLAMA_NUM_PARALLEL). Ollama itself
# only honours the variable at server startup, so export it in the shell
# that launches `ollama serve`, not here.
OLLAMA_NUM_PARALLEL=2
